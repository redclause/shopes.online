---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
const { title = "Shopes — search shops and apps", description = "A focused search engine for online shops, official stores, and app stores." } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <ClientRouter />
  </head>
  <body>
    <header class="shopes-header homepage-logo">
      <a href="/" class="shopes-logo" aria-label="Shopes home">
        <span class="shopes-logo-mark" aria-hidden="true">S</span>
        <span>shopes</span>
      </a>
    </header>
    <slot />
  </body>
</html>