---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const {
  title = "Shopes — Search Online Shops",
  description = "Search engine for online shops and retailers."
} = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="wrap site-header">
      <a href="/" class="shopes-logo" aria-label="Shopes search home">
        <span class="shopes-logo-mark" aria-hidden="true">S</span>
        <span>shopes</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Search</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  .site-header{display:flex;align-items:center;justify-content:space-between;padding-top:1.25rem;padding-bottom:1.25rem}.site-nav{display:flex;align-items:center;gap:.45rem}.site-nav a{padding:.55rem .8rem;border-radius:.75rem;color:#9aa4bd;font-size:.85rem;font-weight:800}.site-nav a:hover{color:#fff;background:rgba(255,255,255,.04)}
</style>
