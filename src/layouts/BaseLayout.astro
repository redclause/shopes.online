---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
const { title = "Shopes — search shops and apps", description = "A focused search engine for online shops, official stores, and app stores." } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <header class="wrap flex items-center justify-between py-5">
      <a href="/" class="shopes-logo" aria-label="Shopes home">
        <span class="shopes-logo-mark" aria-hidden="true">S</span>
        <span>shopes</span>
      </a>
      <a href="/blog" class="rounded-xl border border-[var(--accent)]/25 px-4 py-2 text-sm font-bold text-[var(--accent)] transition hover:bg-[var(--accent)]/10">Blog</a>
    </header>
    <slot />
  </body>
</html>