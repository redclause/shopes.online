---
import BaseLayout from "../layouts/BaseLayout.astro";
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---
<BaseLayout title={initialQuery ? `${initialQuery} — Shopes Search` : "Search — Shopes"} description="Search online shops, official stores, products and apps with Shopes.">
  <main class="wrap min-h-[70vh] py-12 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div><p class="eyebrow">Shopes search</p><h1 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl">Find shops and apps.</h1></div>
        <p class="max-w-sm text-sm leading-6 text-[var(--muted)]">Tavily discovers candidates. Shopes verifies ecommerce and app-store signals before showing results.</p>
      </div>
      <form id="search-form" class="search-shell glass flex overflow-hidden rounded-2xl p-2">
        <span class="grid size-12 shrink-0 place-items-center text-xl text-white/40">⌕</span>
        <input id="search-input" name="q" value={initialQuery} class="min-w-0 flex-1 bg-transparent px-2 text-base text-white outline-none placeholder:text-white/30 sm:text-lg" type="search" autocomplete="off" placeholder="Search shops, brands, products, or apps..." />
        <button class="search-button rounded-xl px-6 text-sm font-black sm:px-8" type="submit">Search</button>
      </form>
      <div class="mt-7 flex items-center justify-between gap-4">
        <p id="search-status" class="text-sm text-[var(--muted)]">{initialQuery ? "Searching…" : "Ready when you are."}</p>
        <span id="provider-status" class="text-xs text-white/30"></span>
      </div>
      <div id="search-results" class="mt-5 space-y-3"></div>
      <div id="empty-state" class="glass mt-5 rounded-3xl px-6 py-16 text-center">
        <div class="mx-auto grid size-16 place-items-center rounded-2xl bg-white/5 text-3xl">⌕</div>
        <h2 class="mt-5 text-xl font-black">Start shopping</h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-[var(--muted)]">Try a brand, product, online shop, retailer, or mobile app.</p>
      </div>
    </div>
  </main>
  <script define:vars={{ initialQuery }}>
    const form = document.querySelector("#search-form");
    const input = document.querySelector("#search-input");
    const status = document.querySelector("#search-status");
    const providerStatus = document.querySelector("#provider-status");
    const results = document.querySelector("#search-results");
    const empty = document.querySelector("#empty-state");
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;" }[char]));
    const render = (items) => {
      empty.hidden = items.length > 0;
      results.innerHTML = items.map((item, index) => {
        const description = String(item.description || "").replace(/\s+/g, " ").trim();
        const shortDescription = description.length > 180 ? `${description.slice(0, 180).replace(/\s+\S*$/, "")}…` : description;
        const label = item.resultType === "app" ? "App" : "Shop";
        const schema = Array.isArray(item.schemaTypes) && item.schemaTypes.length ? item.schemaTypes.slice(0, 4).join(" · ") : "ecommerce signal";
        return `
          <article class="result-card rounded-2xl p-5 opacity-0" style="animation:resultIn .45s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:${Math.min(index * 35, 350)}ms">
            <div class="min-w-0">
              <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-white/35"><span class="size-1.5 rounded-full bg-[var(--accent)]"></span>${escapeHtml(label)} · ${escapeHtml(item.domain || item.source)}</div>
              <h2 class="mt-2 text-lg font-black leading-snug text-white"><a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="transition hover:text-[var(--accent)]">${escapeHtml(item.title)}</a></h2>
              ${shortDescription ? `<p class="mt-1 text-sm leading-6 text-[var(--muted)]">${escapeHtml(shortDescription)}</p>` : ""}
              <div class="mt-4 text-xs font-bold text-[var(--accent)]">Verified · ${escapeHtml(schema)}</div>
            </div>
          </article>`;
      }).join("");
    };
    const search = async (query) => {
      status.textContent = "Finding verified shops and apps…";
      providerStatus.textContent = "";
      results.innerHTML = "";
      empty.hidden = true;
      try {
        const response = await fetch("/api/search?q=" + encodeURIComponent(query), { headers: { accept: "application/json" } });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Search failed");
        render(data.results || []);
        status.textContent = data.results?.length ? `${data.results.length} shops and apps` : "No matching shops or apps found.";
        providerStatus.textContent = data.providers?.length ? data.providers.join(" · ") : "";
      } catch (error) {
        empty.hidden = false;
        status.textContent = error instanceof Error ? error.message : "Search failed.";
      }
    };
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      history.replaceState(null, "", "/search?q=" + encodeURIComponent(query));
      search(query);
    });
    if (initialQuery) search(initialQuery);
  </script>
  <style>
    @keyframes resultIn { from { opacity:0; transform:translateY(10px) } to { opacity:1; transform:translateY(0) } }
    [hidden]{display:none!important}
    @media (prefers-reduced-motion:reduce){article.result-card{animation:none!important;opacity:1}}
  </style>
</BaseLayout>