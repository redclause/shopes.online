---
import BaseLayout from "../layouts/BaseLayout.astro";
import {listings,shops} from "../data/directory";
const q=(Astro.url.searchParams.get("q")||"").trim().toLowerCase();
const matches=[...shops.map(x=>({...x,type:"Local shop"})),...listings.map(x=>({...x,type:"Web directory"}))].filter(x=>!q||[x.name,x.description,...x.tags].join(" ").toLowerCase().includes(q));
---
<BaseLayout title={q?`Search: ${q}`:"Search — Shopes"}><main class="wrap py-14"><form class="flex max-w-3xl overflow-hidden rounded-2xl border border-[var(--line)] bg-white p-1.5" action="/search"><input name="q" value={q} class="min-w-0 flex-1 px-4 py-3 outline-none" placeholder="Search..." /><button class="rounded-xl bg-[var(--ink)] px-6 py-3 text-sm font-bold text-white">Search</button></form><div class="mt-10"><p class="text-xs font-black uppercase tracking-widest text-[var(--muted)]">{matches.length} result{matches.length===1?"":"s"}</p><div class="mt-4 divide-y divide-[var(--line)] rounded-2xl border border-[var(--line)] bg-white">{matches.map(x=><article class="p-5"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><span class="text-[10px] font-black uppercase tracking-widest text-[var(--muted)]">{x.type}</span><h2 class="mt-1 text-lg font-black">{x.name}</h2><p class="mt-1 text-sm text-[var(--muted)]">{x.description}</p></div><a href={x.url} rel="noopener noreferrer" class="shrink-0 rounded-full bg-[var(--ink)] px-5 py-2.5 text-center text-xs font-bold text-white">Visit →</a></div></article>)}</div></div></main></BaseLayout>
