---
import BaseLayout from "../layouts/BaseLayout.astro";
import { searchShops } from "../data/shops";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const category = Astro.url.searchParams.get("category") ?? "";
const results = searchShops(query, category);
---
<BaseLayout title={query ? `Search shops for "${query}" — Shopes` : "Shopes — Search Online Shops"} description={query ? `Search results for online shops matching ${query}.` : "Search engine for online shops. Find stores, retailers and shopping websites in one place."}>
  <script slot="head" is:inline async src="https://cse.google.com/cse.js?cx=e2dc391aa286b4b8d"></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Shopes",
    url: "https://shopes.online/",
    potentialAction: {
      "@type": "SearchAction",
      target: "https://shopes.online/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <main class="wrap home-shell">
    <section class="hero">
      <p class="eyebrow">Online shop search</p>
      <h1>Find online shops.</h1>
      <p class="hero-copy">Search a focused directory of online stores and retailers. Shopes is built for discovering shops — not managing them.</p>
      <div class="shopes-google-search" aria-label="Google shop search">
        <div class="gcse-search"></div>
      </div>
      <nav class="category-row" aria-label="Shop categories">
        {["Electronics","Computers","Phones","Home","Furniture","Clothing","Shoes","Sports","Beauty","Toys","Gifts","Handmade","Kitchen","Gaming","Audio","Marketplace"].map((item) => (
          <a href={"/?category=" + encodeURIComponent(item)} class:list={{ active: category.toLowerCase() === item.toLowerCase() }}>{item}</a>
        ))}
      </nav>
    </section>

    <section class="blog-callout">
      <div>
        <p class="eyebrow">Shopes Blog</p>
        <h2>Shopping knowledge, kept separate from shop search.</h2>
        <p>Browse the existing long-form blog for product research, store comparisons and online shopping guides.</p>
      </div>
      <a href="/blog">Read the blog →</a>
    </section>
  </main>
</BaseLayout>

<style>
  .home-shell{padding:5.5rem 0 6rem}.hero{max-width:900px;margin:0 auto;text-align:center}.hero h1{margin:.75rem 0 0;font-size:clamp(3.25rem,8vw,6.8rem);line-height:.95;letter-spacing:-.065em;font-weight:950;color:#fff}.hero-copy{max-width:650px;margin:1.5rem auto 0;color:var(--muted);font-size:1.1rem;line-height:1.8}
  .shopes-google-search{margin:2.2rem auto 0;max-width:820px;text-align:left}
  .shopes-google-search .gsc-control-cse{padding:0!important;border:0!important;background:transparent!important;font-family:inherit!important}
  .shopes-google-search .gsc-control-wrapper-cse{border:1px solid var(--line)!important;border-radius:1.35rem!important;background:var(--panel)!important;box-shadow:0 24px 80px rgba(0,0,0,.24)!important;overflow:hidden}
  .shopes-google-search .gsc-search-box{margin-bottom:0!important;padding:.55rem!important}
  .shopes-google-search table.gsc-search-box{margin-bottom:0!important}
  .shopes-google-search .gsc-input-box{border:0!important;border-radius:1rem!important;background:rgba(255,255,255,.035)!important;box-shadow:none!important}
  .shopes-google-search input.gsc-input{height:42px!important;padding:0 1rem!important;background:transparent!important;color:#fff!important;font-family:inherit!important;font-size:1.05rem!important}
  .shopes-google-search input.gsc-input::placeholder{color:#66718b!important}
  .shopes-google-search .gsc-search-button-v2{height:44px!important;margin-left:.45rem!important;padding:0 1.2rem!important;border:0!important;border-radius:1rem!important;background:linear-gradient(135deg,var(--accent),#d8ffb9)!important;color:#071006!important;box-shadow:none!important}
  .shopes-google-search .gsc-search-button-v2 svg{fill:#071006!important}
  .shopes-google-search .gsc-results{width:100%!important;padding:1rem!important;background:transparent!important}
  .shopes-google-search .gsc-result{border-color:var(--line)!important;background:transparent!important}
  .shopes-google-search .gs-webResult .gs-title,.shopes-google-search .gs-webResult .gs-title *{color:#fff!important;font-family:inherit!important}
  .shopes-google-search .gs-webResult .gs-title:hover,.shopes-google-search .gs-webResult .gs-title:hover *{color:var(--accent)!important}
  .shopes-google-search .gs-visibleUrl{color:var(--accent)!important}
  .shopes-google-search .gs-webResult .gs-snippet{color:var(--muted)!important;font-family:inherit!important;line-height:1.65!important}
  .shopes-google-search .gsc-cursor-box{border-color:var(--line)!important}
  .shopes-google-search .gsc-cursor-page{color:#b7c0d1!important}
  .shopes-google-search .gsc-cursor-current-page{color:var(--accent)!important}
  .shopes-google-search .gsc-result{padding:.9rem 0!important;border-bottom:1px solid var(--line)!important}
  .shopes-google-search .gsc-result:last-child{border-bottom:0!important}
  .shopes-google-search .gsc-result-info,.shopes-google-search .gsc-orderby-label,.shopes-google-search .gsc-selected-option-container{color:#7f8aa3!important;font-family:inherit!important}
  .shopes-google-search .gsc-above-wrapper-area{border-bottom:1px solid var(--line)!important}
  .shopes-google-search .gs-webResult .gs-title{font-size:1.05rem!important;line-height:1.4!important;font-weight:900!important}
  .shopes-google-search .gs-webResult .gs-snippet{font-size:.9rem!important}
  .shopes-google-search .gsc-cursor-box{padding-top:1rem!important;text-align:center!important}
  .shopes-google-search .gsc-cursor-page{display:inline-block!important;min-width:30px!important;padding:.45rem .55rem!important;margin:0 .15rem!important;border:1px solid var(--line)!important;border-radius:.65rem!important;background:transparent!important}
  .shopes-google-search .gsc-cursor-current-page{background:rgba(163,255,111,.08)!important;border-color:rgba(163,255,111,.45)!important}
  .shopes-google-search .gsc-completion-container{border:1px solid var(--line)!important;border-radius:1rem!important;background:#101629!important;box-shadow:0 20px 60px rgba(0,0,0,.35)!important;color:#fff!important;overflow:hidden!important}
  .shopes-google-search .gsc-completion-selected{background:rgba(163,255,111,.08)!important}
  .shopes-google-search .gsc-completion-container .gsc-completion-title{color:#fff!important;font-family:inherit!important}
  .shopes-google-search .gsc-clear-button{filter:invert(1)!important}
  .shopes-google-search .gsc-search-button-v2:hover{filter:brightness(1.05)!important;box-shadow:0 10px 30px rgba(163,255,111,.2)!important;transform:translateY(-1px)!important}
  .shopes-google-search .gsc-search-button-v2:focus-visible,.shopes-google-search input.gsc-input:focus-visible{outline:2px solid var(--accent)!important;outline-offset:2px!important}
  .category-row{display:flex;flex-wrap:wrap;justify-content:center;gap:.55rem;margin-top:1.2rem}.category-row a{border:1px solid var(--line);border-radius:999px;padding:.5rem .85rem;color:#9aa4bd;font-size:.82rem;transition:.2s}.category-row a:hover,.category-row a.active{color:#fff;border-color:rgba(163,255,111,.45);background:rgba(163,255,111,.08)}@media (max-width:900px){.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:620px){.home-shell{padding-top:3.5rem}.shopes-google-search{margin-top:1.7rem}.shopes-google-search .gsc-search-box{padding:.45rem!important}.shopes-google-search .gsc-search-button-v2{padding:0 .95rem!important}.shop-grid{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column}.blog-callout{align-items:flex-start;flex-direction:column}}
</style>
