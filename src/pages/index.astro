---
import BaseLayout from "../layouts/BaseLayout.astro";
import { shopCategories, searchShops } from "../data/shops";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const category = Astro.url.searchParams.get("category") ?? "";
const results = searchShops(query, category);
---
<BaseLayout title={query ? `Search shops for "${query}" — Shopes` : "Shopes — Search Online Shops"} description={query ? `Search results for online shops matching ${query}.` : "Search engine for online shops. Find stores, retailers and shopping websites in one place."}>
  <script slot="head" is:inline async src="https://cse.google.com/cse.js?cx=e2dc391aa286b4b8d"></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Shopes",
    url: "https://shopes.online/",
    potentialAction: {
      "@type": "SearchAction",
      target: "https://shopes.online/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <main class="wrap home-shell">
    <section class="hero">
      <p class="eyebrow">Online shop search</p>
      <h1>Find online shops.</h1>
      <p class="hero-copy">Search a focused directory of online stores and retailers. Shopes is built for discovering shops — not managing them.</p>
      <div class="shopes-google-search" aria-label="Google shop search">
        <div class="gcse-search"></div>
      </div>
      <div class="category-row" aria-label="Shop categories">
        {shopCategories.map((item) => {
          const href = item === "All shops" ? "/" : "/?category=" + encodeURIComponent(item);
          return <a href={href} class:list={{ active: category.toLowerCase() === item.toLowerCase() || (!category && item === "All shops") }}>{item}</a>;
        })}
      </div>
    </section>

    <section class="results-section" aria-labelledby="results-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{query || category ? "Search results" : "Featured shops"}</p>
          <h2 id="results-heading">{query ? `Shops matching “${query}”` : category ? `${category} shops` : "Explore online shops"}</h2>
        </div>
        <span class="result-count">{results.length} {results.length === 1 ? "shop" : "shops"}</span>
      </div>

      {results.length ? (
        <div class="shop-grid">
          {results.map((shop) => (
            <article class="shop-card">
              <div class="shop-card-top">
                <span class="shop-mark">{shop.name.charAt(0)}</span>
                {shop.featured && <span class="featured-badge">Featured</span>}
              </div>
              <h3><a href={"/shop/" + shop.slug}>{shop.name}</a></h3>
              <p class="domain">{shop.domain}</p>
              <p class="shop-description">{shop.description}</p>
              <div class="tag-list">
                {shop.categories.slice(0, 4).map((item) => <a href={"/?category=" + encodeURIComponent(item)}>{item}</a>)}
              </div>
              <div class="shop-actions">
                <a class="details-link" href={"/shop/" + shop.slug}>Shop details →</a>
                <a class="visit-link" href={shop.url} target="_blank" rel="noopener noreferrer">Visit shop ↗</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state glass">
          <span class="empty-icon">⌕</span>
          <h2>No online shops found</h2>
          <p>Try a shop name, domain, or category such as electronics, furniture, shoes, gifts, or home.</p>
          <a href="/">Show all shops</a>
        </div>
      )}
    </section>

    <section class="blog-callout">
      <div>
        <p class="eyebrow">Shopes Blog</p>
        <h2>Shopping knowledge, kept separate from shop search.</h2>
        <p>Browse the existing long-form blog for product research, store comparisons and online shopping guides.</p>
      </div>
      <a href="/blog">Read the blog →</a>
    </section>
  </main>
</BaseLayout>

<style>
  .home-shell{padding:5.5rem 0 6rem}.hero{max-width:900px;margin:0 auto;text-align:center}.hero h1{margin:.75rem 0 0;font-size:clamp(3.25rem,8vw,6.8rem);line-height:.95;letter-spacing:-.065em;font-weight:950;color:#fff}.hero-copy{max-width:650px;margin:1.5rem auto 0;color:var(--muted);font-size:1.1rem;line-height:1.8}
  .shopes-google-search{margin:2.2rem auto 0;max-width:820px;text-align:left}
  .shopes-google-search .gsc-control-cse{padding:0!important;border:0!important;background:transparent!important;font-family:inherit!important}
  .shopes-google-search .gsc-control-wrapper-cse{border:1px solid var(--line)!important;border-radius:1.35rem!important;background:var(--panel)!important;box-shadow:0 24px 80px rgba(0,0,0,.24)!important;overflow:hidden}
  .shopes-google-search .gsc-search-box{margin-bottom:0!important;padding:.55rem!important}
  .shopes-google-search table.gsc-search-box{margin-bottom:0!important}
  .shopes-google-search .gsc-input-box{border:0!important;border-radius:1rem!important;background:rgba(255,255,255,.035)!important;box-shadow:none!important}
  .shopes-google-search input.gsc-input{height:42px!important;padding:0 1rem!important;background:transparent!important;color:#fff!important;font-family:inherit!important;font-size:1.05rem!important}
  .shopes-google-search input.gsc-input::placeholder{color:#66718b!important}
  .shopes-google-search .gsc-search-button-v2{height:44px!important;margin-left:.45rem!important;padding:0 1.2rem!important;border:0!important;border-radius:1rem!important;background:linear-gradient(135deg,var(--accent),#d8ffb9)!important;color:#071006!important;box-shadow:none!important}
  .shopes-google-search .gsc-search-button-v2 svg{fill:#071006!important}
  .shopes-google-search .gsc-results{width:100%!important;padding:1rem!important;background:transparent!important}
  .shopes-google-search .gsc-result{border-color:var(--line)!important;background:transparent!important}
  .shopes-google-search .gs-webResult .gs-title,.shopes-google-search .gs-webResult .gs-title *{color:#fff!important;font-family:inherit!important}
  .shopes-google-search .gs-webResult .gs-title:hover,.shopes-google-search .gs-webResult .gs-title:hover *{color:var(--accent)!important}
  .shopes-google-search .gs-visibleUrl{color:var(--accent)!important}
  .shopes-google-search .gs-webResult .gs-snippet{color:var(--muted)!important;font-family:inherit!important;line-height:1.65!important}
  .shopes-google-search .gsc-cursor-box{border-color:var(--line)!important}
  .shopes-google-search .gsc-cursor-page{color:#b7c0d1!important}
  .shopes-google-search .gsc-cursor-current-page{color:var(--accent)!important}
  .category-row{display:flex;flex-wrap:wrap;justify-content:center;gap:.55rem;margin-top:1.2rem}.category-row a{border:1px solid var(--line);border-radius:999px;padding:.5rem .85rem;color:#9aa4bd;font-size:.82rem;transition:.2s}.category-row a:hover,.category-row a.active{color:#fff;border-color:rgba(163,255,111,.45);background:rgba(163,255,111,.08)}.results-section{margin-top:6rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.3rem}.section-heading h2{margin:.45rem 0 0;font-size:clamp(1.7rem,4vw,2.7rem);letter-spacing:-.04em;color:#fff;font-weight:900}.result-count{color:#7f8aa3;font-size:.9rem}.shop-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.shop-card{padding:1.3rem;border:1px solid var(--line);border-radius:1.25rem;background:linear-gradient(145deg,rgba(16,22,41,.88),rgba(10,14,25,.76));transition:.25s}.shop-card:hover{transform:translateY(-4px);border-color:rgba(163,255,111,.3)}.shop-card-top{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.shop-mark{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#071006;font-weight:950;font-size:1.15rem}.featured-badge{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--accent);font-weight:900}.shop-card h3{margin:1.15rem 0 .2rem;font-size:1.3rem;font-weight:900;color:#fff}.shop-card h3 a:hover{color:var(--accent)}.domain{margin:0;color:#6f7b95;font-size:.78rem}.shop-description{margin:1rem 0 0;color:var(--muted);font-size:.9rem;line-height:1.65}.tag-list{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1rem}.tag-list a{font-size:.7rem;color:#aeb8cc;border:1px solid var(--line);padding:.3rem .5rem;border-radius:999px}.tag-list a:hover{color:var(--accent)}.shop-actions{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line);font-size:.78rem;font-weight:800}.details-link{color:#dfe6f5}.details-link:hover{color:#fff}.visit-link{color:var(--accent)}.visit-link:hover{filter:brightness(1.1)}.empty-state{text-align:center;padding:4rem 1.5rem;border-radius:1.5rem}.empty-icon{font-size:3rem;color:var(--accent)}.empty-state h2{margin:1rem 0 .5rem;color:#fff;font-size:1.6rem;font-weight:900}.empty-state p{max-width:520px;margin:0 auto 1.5rem;color:var(--muted);line-height:1.7}.empty-state a{color:var(--accent);font-weight:800}.blog-callout{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin-top:5rem;padding:2rem;border:1px solid var(--line);border-radius:1.5rem;background:rgba(15,20,34,.55)}.blog-callout h2{margin:.4rem 0;color:#fff;font-size:1.5rem;font-weight:900}.blog-callout p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.7}.blog-callout>a{white-space:nowrap;color:var(--accent);font-weight:900}@media (max-width:900px){.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:620px){.home-shell{padding-top:3.5rem}.shopes-google-search{margin-top:1.7rem}.shopes-google-search .gsc-search-box{padding:.45rem!important}.shopes-google-search .gsc-search-button-v2{padding:0 .95rem!important}.shop-grid{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column}.blog-callout{align-items:flex-start;flex-direction:column}}
</style>
