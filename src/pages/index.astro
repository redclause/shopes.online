---
import BaseLayout from "../layouts/BaseLayout.astro";
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---
<BaseLayout title="Shopes — shopping search engine" description="A fast shopping search engine for online shops, official stores, products and apps.">
  <main class="relative min-h-screen">
    <div class="hero-orb pulse-glow left-[8%] top-24 size-32 bg-[rgba(110,231,255,.12)] blur-3xl"></div>
    <div class="hero-orb pulse-glow right-[8%] top-44 size-40 bg-[rgba(163,255,111,.10)] blur-3xl"></div>
    <section class="wrap relative flex min-h-[calc(100vh-80px)] flex-col items-center justify-center py-10 text-center">
      <h1 class="shopes-home-title max-w-5xl text-6xl font-black tracking-[-.065em] text-white sm:text-8xl">
        Search shops.<br/><span class="bg-gradient-to-r from-[var(--accent)] to-[var(--accent-2)] bg-clip-text text-transparent">Find more.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg">A focused shopping search engine. Tavily discovers candidates, then Shopes verifies ecommerce and app-store signals before showing results.</p>
      <form id="search-form" class="search-shell glass mt-5 flex w-full max-w-3xl overflow-hidden rounded-2xl p-2 text-left">
        <span class="grid size-12 shrink-0 place-items-center text-xl text-white/40">⌕</span>
        <input id="search-input" name="q" value={initialQuery} aria-label="Search shops" class="min-w-0 flex-1 bg-transparent px-2 text-base text-white outline-none placeholder:text-white/30 sm:text-lg" placeholder="What are you looking for?" />
        <button class="search-button rounded-xl px-6 text-sm font-black sm:px-8" type="submit">Search</button>
      </form>
      <p id="search-status" class="mt-4 text-sm text-[var(--muted)]">{initialQuery ? "Searching…" : "Search online shops, official stores, products, and apps."}</p>
      <div id="search-results" class="mt-7 grid w-full max-w-5xl gap-3 text-left sm:grid-cols-2"></div>
      <div id="empty-state" class="mt-5 hidden glass w-full max-w-3xl rounded-3xl px-6 py-12 text-center">
        <div class="mx-auto grid size-16 place-items-center rounded-2xl bg-white/5 text-3xl">⌕</div>
        <h2 class="mt-5 text-xl font-black">No verified results</h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-[var(--muted)]">Try a brand, product, retailer, online shop, or app.</p>
      </div>
    </section>
  </main>
  <script define:vars={{ initialQuery }}>
    const form = document.querySelector("#search-form");
    const input = document.querySelector("#search-input");
    const status = document.querySelector("#search-status");
    const results = document.querySelector("#search-results");
    const empty = document.querySelector("#empty-state");
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;" }[char]));
    const render = (items) => {
      empty.classList.toggle("hidden", items.length > 0);
      results.innerHTML = items.map((item, index) => {
        const description = String(item.description || "").replace(/\s+/g, " ").trim();
        const shortDescription = description.length > 180 ? `${description.slice(0, 180).replace(/\s+\S*$/, "")}…` : description;
        const label = item.resultType === "app" ? "App" : "Shop";
        const schema = Array.isArray(item.schemaTypes) && item.schemaTypes.length ? item.schemaTypes.slice(0, 4).join(" · ") : "ecommerce signal";
        return `
          <article class="result-card rounded-2xl p-5 opacity-0" style="animation:resultIn .45s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:${Math.min(index * 35, 350)}ms">
            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-white/35"><span class="size-1.5 rounded-full bg-[var(--accent)]"></span>${escapeHtml(label)} · ${escapeHtml(item.domain || item.source)}</div>
            <h2 class="mt-2 text-lg font-black leading-snug text-white"><a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="transition hover:text-[var(--accent)]">${escapeHtml(item.title)}</a></h2>
            ${shortDescription ? `<p class="mt-1 text-sm leading-6 text-[var(--muted)]">${escapeHtml(shortDescription)}</p>` : ""}
            <div class="mt-4 text-xs font-bold text-[var(--accent)]">Verified · ${escapeHtml(schema)}</div>
          </article>`;
      }).join("");
    };
    const search = async (query) => {
      status.textContent = "Finding verified shops and apps…";
      results.innerHTML = "";
      empty.classList.add("hidden");
      try {
        const response = await fetch("/api/search?q=" + encodeURIComponent(query), { headers: { accept: "application/json" } });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Search failed");
        render(data.results || []);
        status.textContent = data.results?.length ? `${data.results.length} verified shops and apps` : "No matching shops or apps found.";
      } catch (error) {
        empty.classList.remove("hidden");
        status.textContent = error instanceof Error ? error.message : "Search failed.";
      }
    };
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      history.replaceState(null, "", "/?q=" + encodeURIComponent(query));
      search(query);
    });
    if (initialQuery) search(initialQuery);
  </script>
  <style>
    @keyframes resultIn { from { opacity:0; transform:translateY(10px) } to { opacity:1; transform:translateY(0) } }
    .shopes-logo-mark{animation:shopesLogoFloat 4s ease-in-out infinite}\n    .shopes-logo{animation:shopesLogoFloat 6s ease-in-out infinite}\n    @media (prefers-reduced-motion:reduce){article.result-card{animation:none!important;opacity:1}.shopes-logo,.shopes-logo-mark{animation:none}}
  </style>
</BaseLayout>