---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ARTICLE_COUNT, getArticleMeta } from "../data/shopping-articles";

const PAGE_SIZE = 100;
const start = 1;
const end = Math.min(PAGE_SIZE, ARTICLE_COUNT);
const articles = Array.from({ length: end - start + 1 }, (_, index) => getArticleMeta(start + index)).filter(Boolean);
const pageCount = Math.ceil(ARTICLE_COUNT / PAGE_SIZE);
---
<BaseLayout title="Shopes Blog — Online Shopping" description="Shopes Blog: practical online shopping guides, product research, store comparisons, and buying knowledge.">
  <main class="wrap py-10 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <p class="eyebrow">Shopes Blog</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-6xl">Online shopping knowledge.</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">Practical, long-form guides for researching products, comparing online stores, understanding offers, and making better-informed shopping decisions.</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <span class="rounded-full border border-white/10 px-4 py-2 text-white/60">{ARTICLE_COUNT.toLocaleString()} articles</span>
        <span class="rounded-full border border-white/10 px-4 py-2 text-white/60">100 articles per page</span>
        <span class="rounded-full border border-white/10 px-4 py-2 text-white/60">10,000+ characters per article</span>
      </div>
      <section class="mt-10 grid gap-4 sm:grid-cols-2">
        {articles.map((article) => article && (
          <a href={"/blog/" + article.slug} class="result-card rounded-2xl p-6 transition hover:-translate-y-1">
            <p class="text-xs font-black uppercase tracking-widest text-[var(--accent)]">Shopping guide · #{article.id.toLocaleString()}</p>
            <h2 class="mt-3 text-xl font-black leading-snug text-white">{article.title}</h2>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{article.description}</p>
            <span class="mt-5 inline-block text-sm font-bold text-white/60">Read article →</span>
          </a>
        ))}
      </section>
      <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Blog pages">
        <span class="rounded-xl border border-white/10 px-4 py-2 text-sm text-white/40">Page 1 of {pageCount.toLocaleString()}</span>
        <a href="/blog/page/2" class="rounded-xl border border-[var(--accent)]/30 px-4 py-2 text-sm font-bold text-[var(--accent)] transition hover:bg-[var(--accent)]/10">Next →</a>
      </nav>
    </div>
  </main>
</BaseLayout>
