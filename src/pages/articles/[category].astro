---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shoppingCategories, ARTICLE_COUNT, getArticle } from "../../data/shopping-articles";
const slugify=(s:string)=>s.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
const categorySlug=Astro.params.category ?? "";
const category=shoppingCategories.find(c=>slugify(c)===categorySlug);
if(!category)return Astro.redirect("/articles");
const categoryIndex=shoppingCategories.indexOf(category);
const count=Math.floor(ARTICLE_COUNT/shoppingCategories.length);
const examples=Array.from({length:12},(_,i)=>getArticle(categoryIndex*count+i+1)).filter(Boolean);
---
<BaseLayout title={category+" Shopping Articles — Shopes"} description={"Shopping guides for "+category+". Browse Shopes articles by category."}>
  <main class="wrap py-10 sm:py-14">
    <div class="mx-auto max-w-5xl">
      <a href="/articles" class="text-sm font-bold text-white/50 hover:text-[var(--accent)]">← All shopping categories</a>
      <p class="eyebrow mt-8">Category</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-6xl">{category} shopping articles.</h1>
      <p class="mt-5 text-lg leading-8 text-[var(--muted)]">Browse guides about {category}, covering practical buying decisions, product research, store comparison, delivery, compatibility, value, and everyday use.</p>
      <div class="mt-10 space-y-3">
        {examples.map((article)=><a href={"/shopping/"+article!.slug} class="result-card block rounded-2xl p-5">
          <h2 class="font-black">{article!.title}</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{article!.description}</p>
        </a>)}
      </div>
    </div>
  </main>
</BaseLayout>
