---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shoppingCategories, ARTICLE_COUNT } from "../../data/shopping-articles";
const slugify=(s:string)=>s.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
const perCategory=Math.floor(ARTICLE_COUNT/shoppingCategories.length);
---
<BaseLayout title="Shopping Articles — Shopes" description="Browse Shopes shopping guides by category.">
  <main class="wrap py-10 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <p class="eyebrow">Shopping knowledge</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-6xl">Shopping articles by category.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">Browse practical shopping guides organized around the products and categories people actually shop for.</p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {shoppingCategories.map((category)=><a href={"/articles/"+slugify(category)} class="glass group rounded-2xl p-5 transition hover:-translate-y-1 hover:border-[var(--accent)]/30">
          <h2 class="font-black group-hover:text-[var(--accent)]">{category}</h2>
          <p class="mt-2 text-xs text-[var(--muted)]">~{perCategory.toLocaleString()} shopping guides</p>
        </a>)}
      </div>
    </div>
  </main>
</BaseLayout>
