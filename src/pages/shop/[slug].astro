---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getShop } from "../../data/shops";

const shop = getShop(Astro.params.slug ?? "");
if (!shop) return Astro.redirect("/", 302);
---
<BaseLayout title={shop.name + " — Online Shop — Shopes"} description={shop.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "OnlineStore",
    name: shop.name,
    url: shop.url,
    description: shop.description,
    areaServed: shop.country
  })} />
  <main class="wrap shop-page">
    <a href="/" class="back-link">← Shop search</a>
    <article class="shop-profile glass">
      <div class="profile-mark">{shop.name.charAt(0)}</div>
      <p class="eyebrow">Online shop</p>
      <h1>{shop.name}</h1>
      <p class="domain">{shop.domain}</p>
      <p class="profile-description">{shop.description}</p>
      <div class="tag-list">
        {shop.categories.map((item) => <a href={"/?category=" + encodeURIComponent(item)}>{item}</a>)}
      </div>
      <div class="profile-meta">
        <span>Country: {shop.country}</span>
        <span>Indexed by Shopes</span>
      </div>
      <a class="visit-button" href={shop.url} target="_blank" rel="noopener noreferrer">Visit {shop.name} ↗</a>
    </article>
  </main>
</BaseLayout>

<style>
  .shop-page{max-width:850px;padding:4rem 0 6rem}
  .back-link{color:#8792a9;font-size:.9rem;font-weight:800}.back-link:hover{color:#fff}
  .shop-profile{margin-top:1.5rem;padding:clamp(2rem,6vw,4.5rem);border-radius:2rem;text-align:center}
  .profile-mark{display:grid;place-items:center;width:76px;height:76px;margin:0 auto 1.5rem;border-radius:22px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#071006;font-size:1.8rem;font-weight:950}
  .shop-profile h1{margin:.5rem 0 .2rem;color:#fff;font-size:clamp(2.7rem,7vw,5rem);line-height:1;letter-spacing:-.06em;font-weight:950}
  .domain{color:#6f7b95;font-size:.85rem}
  .profile-description{max-width:680px;margin:1.5rem auto 0;color:var(--muted);font-size:1.05rem;line-height:1.8}
  .tag-list{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-top:1.5rem}.tag-list a{padding:.4rem .7rem;border:1px solid var(--line);border-radius:999px;color:#b7c0d1;font-size:.78rem}.tag-list a:hover{color:var(--accent)}
  .profile-meta{display:flex;justify-content:center;flex-wrap:wrap;gap:1rem;margin-top:1.5rem;color:#727d94;font-size:.8rem}
  .visit-button{display:inline-block;margin-top:2rem;padding:.9rem 1.3rem;border-radius:1rem;background:var(--accent);color:#071006;font-weight:950}
  .visit-button:hover{filter:brightness(1.06)}
</style>
