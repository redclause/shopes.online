---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Submit a listing — Shopes"><main class="wrap max-w-2xl py-16"><p class="text-xs font-black uppercase tracking-widest text-[var(--muted)]">Directory submission</p><h1 class="mt-3 text-5xl font-black">Submit a listing</h1><p class="mt-5 text-[var(--muted)]">The beta directory is curated. Send the basic details and the team can review the listing.</p><form class="mt-10 space-y-4"><input required placeholder="Business or website name" class="w-full rounded-xl border border-[var(--line)] bg-white p-4 outline-none"/><input type="url" required placeholder="Website URL" class="w-full rounded-xl border border-[var(--line)] bg-white p-4 outline-none"/><input placeholder="Country / city" class="w-full rounded-xl border border-[var(--line)] bg-white p-4 outline-none"/><textarea placeholder="Short description" rows="5" class="w-full rounded-xl border border-[var(--line)] bg-white p-4 outline-none"></textarea><button type="button" class="rounded-full bg-[var(--ink)] px-6 py-3 text-sm font-bold text-white">Submit for beta review</button></form></main></BaseLayout>
