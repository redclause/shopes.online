---
import BaseLayout from "../layouts/BaseLayout.astro";

const initialUrl = Astro.url.searchParams.get("url") ?? "";
const source = Astro.url.searchParams.get("source") ?? "directory";
---
<BaseLayout title="Submit a Website — Shopes" description="Submit a website, local shop, or business for review in the Shopes directory.">
  <main class="min-h-screen px-4 py-14 sm:py-20">
    <div class="mx-auto max-w-2xl">
      <a href="/" class="mx-auto mb-10 flex w-fit items-center gap-3 text-3xl font-black tracking-tight">
        <span class="grid size-10 place-items-center rounded-xl bg-[var(--accent)] text-sm text-[#071006]">S</span>
        shopes<span class="text-[var(--accent)]">.</span>
      </a>

      <section class="glass rounded-3xl p-6 sm:p-9">
        <p class="eyebrow">Submit</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Add a website or shop</h1>
        <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
          Send us a website, business, local shop, or useful service. Submissions are reviewed before appearing in the Shopes directory.
        </p>

        <form id="submission-form" class="mt-8 space-y-5">
          <input type="hidden" name="source" value={source} />
          <div>
            <label for="name" class="text-sm font-bold">Name <span class="text-[var(--accent)]">*</span></label>
            <input id="name" name="name" required maxlength="120" placeholder="Business or website name" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50" />
          </div>
          <div>
            <label for="url" class="text-sm font-bold">Website URL <span class="text-[var(--accent)]">*</span></label>
            <input id="url" name="url" required maxlength="1000" type="url" value={initialUrl} placeholder="https://example.com" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50" />
          </div>
          <div>
            <label for="description" class="text-sm font-bold">Description</label>
            <textarea id="description" name="description" maxlength="600" rows="4" placeholder="What does this website or business offer?" class="mt-2 w-full resize-y rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50"></textarea>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="category" class="text-sm font-bold">Category</label>
              <input id="category" name="category" maxlength="80" placeholder="e.g. Restaurants" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50" />
            </div>
            <div>
              <label for="city" class="text-sm font-bold">City</label>
              <input id="city" name="city" maxlength="100" placeholder="e.g. Tbilisi" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50" />
            </div>
          </div>
          <div>
            <label for="country" class="text-sm font-bold">Country</label>
            <input id="country" name="country" maxlength="100" placeholder="e.g. Georgia" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50" />
          </div>
          <div>
            <label for="email" class="text-sm font-bold">Contact email <span class="font-normal text-white/30">(optional)</span></label>
            <input id="email" name="email" maxlength="200" type="email" placeholder="you@example.com" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition focus:border-[var(--accent)]/50" />
            <p class="mt-2 text-xs text-white/30">Only use an email you are comfortable sharing for this submission.</p>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
            <a href="/directory" class="text-sm font-bold text-[var(--muted)] transition hover:text-white">← Back to directory</a>
            <button id="submit-button" type="submit" class="search-button rounded-full px-7 py-3 font-black">Submit for review</button>
          </div>
          <p id="form-message" class="hidden rounded-2xl px-4 py-3 text-sm leading-6"></p>
        </form>
      </section>
    </div>
  </main>

  <script>
    const form = document.querySelector("#submission-form");
    const button = document.querySelector("#submit-button");
    const message = document.querySelector("#form-message");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = "Submitting…";
      message.hidden = true;

      try {
        const response = await fetch("/api/submit", { method: "POST", body: new FormData(form) });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Submission failed.");
        message.className = "rounded-2xl border border-[var(--accent)]/20 bg-[var(--accent)]/10 px-4 py-3 text-sm leading-6 text-white";
        message.textContent = "Thanks — your submission was received and is waiting for review.";
        message.hidden = false;
        form.reset();
      } catch (error) {
        message.className = "rounded-2xl border border-red-300/20 bg-red-300/10 px-4 py-3 text-sm leading-6 text-white";
        message.textContent = error instanceof Error ? error.message : "Submission failed. Please try again.";
        message.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = "Submit for review";
      }
    });
  </script>
</BaseLayout>