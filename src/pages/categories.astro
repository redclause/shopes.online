---
import BaseLayout from "../layouts/BaseLayout.astro";
import {categories} from "../data/directory";
---
<BaseLayout title="Categories — Shopes"><main class="wrap py-16"><p class="text-xs font-black uppercase tracking-widest text-[var(--muted)]">Directory browser</p><h1 class="mt-3 text-5xl font-black tracking-tight">Categories</h1><div class="mt-10 grid gap-5 sm:grid-cols-2">{categories.map(c=><section class="rounded-2xl border border-[var(--line)] bg-white p-6"><a href={`/category/${c.slug}`} class="text-xl font-black">{c.name}</a><ul class="mt-4 space-y-2">{c.children?.map(ch=><li><a class="text-sm text-[var(--muted)] hover:text-[var(--ink)]" href={`/category/${c.slug}/${ch.slug}`}>{ch.name} →</a></li>)}</ul></section>)}</div></main></BaseLayout>
