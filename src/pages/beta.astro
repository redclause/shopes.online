---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Beta — Shopes"><main class="wrap max-w-2xl py-16"><p class="text-xs font-black uppercase tracking-widest text-[var(--muted)]">Early access</p><h1 class="mt-3 text-5xl font-black">Join the Shopes beta</h1><p class="mt-5 text-lg leading-8 text-[var(--muted)]">Help shape a quieter way to discover local shops and useful websites.</p><form class="mt-10 space-y-4"><input type="email" required placeholder="Email address" class="w-full rounded-xl border border-[var(--line)] bg-white p-4 outline-none"/><textarea placeholder="What would you like to discover?" rows="5" class="w-full rounded-xl border border-[var(--line)] bg-white p-4 outline-none"></textarea><button type="button" class="rounded-full bg-[var(--ink)] px-6 py-3 text-sm font-bold text-white">Apply for beta</button></form></main></BaseLayout>
