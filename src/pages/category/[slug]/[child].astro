---
import BaseLayout from "../../../layouts/BaseLayout.astro"; import {categories,listings} from "../../../data/directory";
export function getStaticPaths(){return categories.flatMap(c=>(c.children??[]).map(child=>({params:{slug:c.slug,child:child.slug},props:{category:c,child}})))}
const {category,child}=Astro.props; const entries=listings.filter(x=>x.category===category.slug&&x.tags.includes(child.slug));
---
<BaseLayout title={`${child.name} — Shopes`}><main class="wrap py-14"><p class="text-xs font-black uppercase tracking-widest text-[var(--muted)]">{category.name}</p><h1 class="mt-3 text-5xl font-black">{child.name}</h1><div class="mt-10 space-y-3">{entries.length?entries.map(x=><article data-pagefind-body class="rounded-2xl border border-[var(--line)] bg-white p-5"><h2 class="text-lg font-black">{x.name}</h2><p class="mt-1 text-sm text-[var(--muted)]">{x.description}</p><a href={x.url} rel="noopener noreferrer" class="mt-4 inline-flex rounded-full bg-[var(--ink)] px-5 py-2.5 text-xs font-bold text-white">Visit →</a></article>):<div class="rounded-2xl border border-dashed border-[var(--line)] p-10 text-center text-sm text-[var(--muted)]">This section is ready for new indexed listings.</div>}</div></main></BaseLayout>